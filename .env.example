# Core
MB_ENV=production
MB_SECRET_KEY=replace-with-random-64-char-secret
MB_BASE_URL=https://montanablotter.com

# Email ingest (IMAP)
MB_EMAIL_USER=records@montanablotter.com
MB_EMAIL_PASSWORD=replace-me
MB_IMAP_SERVER=imap.ionos.com
MB_IMAP_PORT=993

# Outbound SMTP
MB_SMTP_SERVER=smtp.gmail.com
MB_SMTP_PORT=587
MB_SMTP_USER=montanablotter@gmail.com
MB_SMTP_PASSWORD=replace-me
MB_ADMIN_BOOTSTRAP_PASSWORD=

# Optional AI keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Turso read replica
MB_TURSO_ENABLED=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Facebook publisher + login
MB_FACEBOOK_APP_ID=
MB_FACEBOOK_APP_SECRET=
MB_FACEBOOK_PAGE_ID=
MB_FACEBOOK_PAGE_ACCESS_TOKEN=
MB_FACEBOOK_GRAPH_API_VERSION=v22.0

# Optional donations (Stripe)
MB_DONATIONS_ENABLED=false
MB_STRIPE_PUBLISHABLE_KEY=
MB_STRIPE_SECRET_KEY=
MB_STRIPE_WEBHOOK_SECRET=
MB_DONATION_MONTHLY_PRICE_ID=
MB_DONATION_CURRENCY=usd
MB_DONATION_MIN_CENTS=500
MB_DONATION_SUGGESTED_AMOUNTS=500,1500,2500,5000

# Warrant access pricing (Stripe)
MB_WARRANT_TRIAL_FEE_PRICE_ID=
MB_WARRANT_MONTHLY_PRICE_ID=

# Ad-watched warrant unlock (free-for-attention path).
# Provider priority: if MB_WARRANT_UNLOCK_MONETAG_ZONE_ID is set, the page uses
# Monetag's rewarded video SDK (real ad revenue, $1-5 CPM for US traffic).
# Otherwise it falls back to the YouTube embed (no revenue — useful for
# sponsor/PSA content where you don't want third-party ads).
#
# To enable Monetag: sign up at monetag.com, add montanablotter.com as a
# publisher site, create a "Rewarded Video" ad zone, paste the zone id here.
MB_WARRANT_UNLOCK_MONETAG_ZONE_ID=
# Use the video id from a YouTube URL: https://www.youtube.com/watch?v=XXXXXXXXXXX
MB_WARRANT_UNLOCK_YOUTUBE_VIDEO_ID=
MB_WARRANT_UNLOCK_MIN_WATCH_SECONDS=15
MB_WARRANT_UNLOCK_DURATION_HOURS=24
MB_WARRANT_UNLOCK_RATE_LIMIT_PER_HOUR=5
MB_WARRANT_UNLOCK_NONCE_TTL_SECONDS=600

# Optional hardening
MB_SESSION_COOKIE_SECURE=true
MB_SESSION_COOKIE_SAMESITE=Lax
MB_MAX_UPLOAD_MB=20
MB_ADMIN_LOGIN_MAX_ATTEMPTS=5
MB_ADMIN_LOGIN_WINDOW_MINUTES=15
MB_ADMIN_LOGIN_LOCKOUT_MINUTES=15
MB_REFERRER_POLICY=strict-origin-when-cross-origin
MB_X_FRAME_OPTIONS=SAMEORIGIN
MB_API_CORS_ALLOW_ORIGIN=*

# Optional API key management (for /api/auth/* endpoints)
# Set this to a strong random string to enable admin API key creation.
# Keys are created via POST /api/auth/keys with X-Admin-Secret header.
MB_API_ADMIN_SECRET=

# Optional API tier overrides (JSON). If unset, defaults are used.
# MB_API_TIERS='{"free":{"window_seconds":86400,"max_requests":100},"pro":{"window_seconds":86400,"max_requests":1000},"enterprise":{"window_seconds":86400,"max_requests":100000}}'

MB_CONTENT_SECURITY_POLICY="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; connect-src 'self' https:; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
MB_SCOUT_HTTP_MAX_ATTEMPTS=5
MB_SCOUT_HTTP_BASE_DELAY_SECONDS=0.75
MB_SCOUT_HTTP_MAX_DELAY_SECONDS=12
MB_SCOUT_HTTP_JITTER_SECONDS=0.8
MB_SCOUT_INTER_PAGE_DELAY_MIN_SECONDS=0.15
MB_SCOUT_INTER_PAGE_DELAY_MAX_SECONDS=1.0

# Optional Montana civil filings (FullCourt / iCourtCase) scraping overrides.
# Capture these with: scripts/maintenance/capture_icourtcase_session.py
ICOURTCASE_BASE_URLS=https://dcportal.pubcourts.mt.gov
ICOURTCASE_SEARCH_PATHS=/public-portal/search/civil
ICOURTCASE_COOKIE_HEADER=

# Optional registry scraper safety/tuning
MB_SEX_OFFENDER_VERIFY_SSL=true
MB_SEX_OFFENDER_MIN_COUNTIES_FOR_FULL_SYNC=50
