# Core
MB_ENV=production
MB_SECRET_KEY=replace-with-random-64-char-secret
MB_BASE_URL=https://montanablotter.com

# Email ingest (IMAP)
MB_EMAIL_USER=records@montanablotter.com
MB_EMAIL_PASSWORD=replace-me
MB_IMAP_SERVER=imap.ionos.com
MB_IMAP_PORT=993

# Outbound SMTP
MB_SMTP_SERVER=smtp.gmail.com
MB_SMTP_PORT=587
MB_SMTP_USER=montanablotter@gmail.com
MB_SMTP_PASSWORD=replace-me
MB_ADMIN_BOOTSTRAP_PASSWORD=

# Optional AI keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Facebook publisher
MB_FACEBOOK_PAGE_ID=
MB_FACEBOOK_PAGE_ACCESS_TOKEN=
MB_FACEBOOK_GRAPH_API_VERSION=v22.0

# Optional donations (Stripe)
MB_DONATIONS_ENABLED=false
MB_STRIPE_PUBLISHABLE_KEY=
MB_STRIPE_SECRET_KEY=
MB_STRIPE_WEBHOOK_SECRET=
MB_DONATION_MONTHLY_PRICE_ID=
MB_DONATION_CURRENCY=usd
MB_DONATION_MIN_CENTS=500
MB_DONATION_SUGGESTED_AMOUNTS=500,1500,2500,5000

# Optional hardening
MB_SESSION_COOKIE_SECURE=true
MB_SESSION_COOKIE_SAMESITE=Lax
MB_MAX_UPLOAD_MB=20
MB_ADMIN_LOGIN_MAX_ATTEMPTS=5
MB_ADMIN_LOGIN_WINDOW_MINUTES=15
MB_ADMIN_LOGIN_LOCKOUT_MINUTES=15
MB_REFERRER_POLICY=strict-origin-when-cross-origin
MB_X_FRAME_OPTIONS=SAMEORIGIN
MB_API_CORS_ALLOW_ORIGIN=*
MB_CONTENT_SECURITY_POLICY="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; connect-src 'self' https:; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
