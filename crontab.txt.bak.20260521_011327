# OpenClaw pipeline agents — run once and exit (--once) so they don't hold RAM.
# Staggered 8 minutes apart so at most one agent runs at a time.
# reporter fetches blotters → clerk deduplicates/scrubs → publisher posts to site.
0 * * * * PATH=/root/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin /root/montanablotter/venv/bin/python3 /root/montanablotter/job_runner.py --name openclaw_reporter --log /root/montanablotter/logs/openclaw_reporter.log --workdir /root/montanablotter -- /root/montanablotter/venv/bin/python3 /root/montanablotter/openclaw_launcher.py --agent reporter --prompt "Fetch and parse the latest Montana law enforcement blotters and jail rosters. Output structured JSON for the Clerk to ingest." --once
8 * * * * PATH=/root/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin /root/montanablotter/venv/bin/python3 /root/montanablotter/job_runner.py --name openclaw_clerk --log /root/montanablotter/logs/openclaw_clerk.log --workdir /root/montanablotter -- /root/montanablotter/venv/bin/python3 /root/montanablotter/openclaw_launcher.py --agent clerk --prompt "Deduplicate incoming records, scrub PII, normalize agencies, and stage clean data for the public site. Run any pending migrations safely." --once
16 * * * * PATH=/root/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin /root/montanablotter/venv/bin/python3 /root/montanablotter/job_runner.py --name openclaw_publisher --log /root/montanablotter/logs/openclaw_publisher.log --workdir /root/montanablotter -- /root/montanablotter/venv/bin/python3 /root/montanablotter/openclaw_launcher.py --agent publisher --prompt "Take finalized, cleaned content from the Clerk and publish it to the montanablotter website. Manage scheduling, formatting, and deployment of new blotter posts." --once

# Montana Highway Patrol crash news releases — daily at 8am
0 8 * * * /root/montanablotter/venv/bin/python3 /root/montanablotter/job_runner.py --name mhp_crashes --log /root/montanablotter/logs/mhp_crashes.log --workdir /root/montanablotter -- /root/montanablotter/venv/bin/python3 -m services.ingestion.fetchers.mhp_crashes

# Geocoding backfill — normalize and geocode un-geocoded blotter locations (twice daily, 500 records/run)
30 3,15 * * * /root/montanablotter/venv/bin/python3 /root/montanablotter/job_runner.py --name geocode_backfill --log /root/montanablotter/logs/geocode_backfill.log --workdir /root/montanablotter -- /root/montanablotter/venv/bin/python3 -m services.geo.pipeline backfill --batch 500

