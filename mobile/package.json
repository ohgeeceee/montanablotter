{
  "name": "montanablotter",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "config": "npx expo config --json",
    "ci:verify": "npm run typecheck && npm run config",
    "e2e:test": "maestro test .maestro",
    "e2e:studio": "maestro studio",
    "build:preview:ios": "npx eas build --platform ios --profile preview",
    "build:preview:android": "npx eas build --platform android --profile preview",
    "build:preview:all": "npx eas build --platform all --profile preview",
    "build:production:ios": "npx eas build --platform ios --profile production",
    "build:production:android": "npx eas build --platform android --profile production",
    "submit:production:ios": "npx eas submit --platform ios --profile production",
    "submit:production:android": "npx eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@expo/webpack-config": "^19.0.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@sentry/react-native": "~8.14.1",
    "expo": "~56.0.12",
    "expo-device": "~5.9.4",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~12.8.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~1.11.1",
    "expo-updates": "~57.0.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-maps": "1.10.0",
    "react-native-purchases": "^7.28.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3"
  },
  "private": true
}
