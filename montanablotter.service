[Unit]
Description=Montana Blotter Flask App
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/montanablotter
EnvironmentFile=/root/montanablotter/.env
ExecStart=/root/montanablotter/venv/bin/gunicorn -c /root/montanablotter/gunicorn.conf.py --bind 127.0.0.1:5000 -m 000 app:app
Restart=always
RestartSec=5
StandardOutput=append:/root/montanablotter/logs/gunicorn.log
StandardError=append:/root/montanablotter/logs/gunicorn.log

# Tighten defaults for any files the service creates.
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

# Additional hardening (keep compatible with a /root working directory).
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# Explicitly allow writing only where we expect it.
ReadWritePaths=/root/montanablotter

[Install]
WantedBy=multi-user.target
