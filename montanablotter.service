[Unit]
Description=Montana Blotter Flask App
After=network.target

[Service]
User=montanablotter
Group=montanablotter
WorkingDirectory=/opt/montanablotter
EnvironmentFile=/opt/montanablotter/.env
ExecStart=/opt/montanablotter/venv/bin/gunicorn -w 3 --bind unix:/tmp/montanablotter.sock -m 000 app:app
Restart=always
RestartSec=5
StandardOutput=append:/opt/montanablotter/gunicorn.log
StandardError=append:/opt/montanablotter/gunicorn.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
